<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/fname"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="FirstName"
        android:textColor="#256742"
        android:textSize="25sp" />
    <EditText
        android:id="@+id/fname_edit"
        android:layout_toRightOf="@+id/fname"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:hint="enter name here"
        android:textSize="25sp"
        android:textColor="#256742"
        />
    <TextView
        android:id="@+id/age"
        android:layout_below="@+id/fname"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="Age"
        android:textSize="25sp"
        android:textColor="#256742"/>
    <EditText
        android:id="@+id/age_edit"
        android:layout_below="@+id/fname_edit"

        android:hint="Enter age here"
        android:layout_height="50dp"
       android:layout_toRightOf="@+id/age"
        android:layout_width="wrap_content"
        />
    <ImageView
        android:layout_below="@+id/age"
        android:id="@+id/imgv"
        android:src="@drawable/capture"
        android:layout_width="400dp"
        android:layout_height="350dp"/>
    <Spinner
        android:id="@+id/coursesspinner"
        android:layout_below="@+id/imgv"
        android:layout_height="50dp"
        android:layout_width="160dp"
        />
    <Button
        android:id="@+id/save"
        android:layout_below="@+id/coursesspinner"
        android:text="Save"
        android:layout_width="wrap_content"
         android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/delete"
        android:layout_below="@+id/coursesspinner"
        android:text="Delete"
        android:layout_alignParentRight="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_below="@+id/save"
        android:layout_height="wrap_content"
        android:id="@+id/radioGroup">

        <RadioButton
            android:id="@+id/radioMale"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="  Male"
            android:layout_marginTop="10dp"
            android:checked="false"
            android:textSize="20dp" />

        <RadioButton
            android:id="@+id/radioFemale"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="   Female"
            android:layout_marginTop="20dp"
            android:checked="false"

            android:textSize="20dp" />
    </RadioGroup>
</RelativeLayout>