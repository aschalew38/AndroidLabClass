<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:id="@+id/fname"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="FirstName"
                android:textSize="25sp"
                android:textColor="#256742"
                />
            <EditText
                android:id="@+id/fname_edit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_toRightOf="@+id/fname"
                android:hint="enter name here"
                android:textSize="25sp"
                android:textColor="#256742"
                />
            <TextView
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_below="@+id/fname"
                android:text="Age"
                android:textSize="25sp"
                android:textColor="#256742"/>
            <EditText
                android:id="@+id/age_edit"
                android:layout_width="match_parent"
                android:hint="Enter age here"
                android:textSize="25sp"
                android:layout_height="50dp"
                android:layout_toRightOf="@+id/age"
                android:layout_below="@+id/fname_edit"
                />
            <TextView
                android:id="@+id/gender_id"
                android:text="Gender"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_below="@+id/age"
                />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/age_edit"
                android:layout_toRightOf="@+id/gender_id"
                >
                <TextView
                    android:id="@+id/male_rbt"
                    android:text="male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
                <RadioButton
                    android:id="@+id/male_id"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>
                <TextView
                    android:id="@+id/female_rbt"
                    android:text="female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
                <RadioButton
                    android:id="@+id/female_id"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/profileimage"
                android:src="@drawable/alarm"
                android:layout_below="@+id/gender_id"
                android:layout_width="400dp"
                android:layout_height="300dp"
                />
            <Spinner
                android:id="@+id/coursesspinner"
                android:layout_below="@+id/profileimage"
                android:layout_height="50dp"
                android:layout_width="160dp"
                />
            <Button
                android:id="@+id/bt1"
                android:text="Save"
                android:layout_below="@+id/coursesspinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/bt2"
                android:text="Delete"
                android:layout_alignParentRight="true"
                android:layout_below="@+id/coursesspinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </ScrollView>


</RelativeLayout>